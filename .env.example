# The server address.
# Defaults to 0.0.0.0.
SERVER_ADDRESS=0.0.0.0

# The server port.
# Defaults to $PORT or 8080.
SERVER_PORT=8080

# The database URL.
DB_URL=jdbc:postgresql://HOST:PORT/DATABASE

# The database username.
DB_USERNAME=database_username

# The database password.
DB_PASSWORD=database_password

# Controls how Hibernate manages the database schema.
# Have a look at this link for possible values:
# https://docs.hibernate.org/stable/orm/javadocs/org/hibernate/tool/schema/Action.html#enum-constant-summary
# Defaults to update.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# The storage to use for the repositories.
# Can be inmemory or filesystem.
# Defaults to inmemory.
STORAGE_TYPE=inmemory

# The root directory for the filesystem storage.
# Only required if $STORAGE_TYPE is filesystem.
FILESYSTEM_STORAGE_ROOT=/tmp
